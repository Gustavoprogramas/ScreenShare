<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: mantém a página abaixo da barra de status (sem desenhar atrás dela). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_bg</item>
        <item name="android:colorPrimary">@color/nexus_primary</item>
        <item name="android:colorAccent">@color/nexus_primary</item>
        <item name="android:statusBarColor">@color/nexus_bg</item>
        <item name="android:navigationBarColor">@color/nexus_bg</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
